{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family record contribution",
  "type": "object",
  "required": ["person", "claim", "evidenceType", "publicationConsent"],
  "properties": {
    "person": { "type": "string" },
    "claim": { "type": "string" },
    "proposedValue": { "type": "string" },
    "evidenceType": {
      "type": "string",
      "enum": ["record", "photograph", "oral-history", "family-tree", "published-source", "other"]
    },
    "sourceDescription": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "contributorRelationship": { "type": "string" },
    "publicationConsent": {
      "type": "string",
      "enum": ["public", "family-only", "private-archive"]
    },
    "notes": { "type": "string" }
  }
}
